{
  "name": "@taku/agent-app",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "prestart": "npm run prepare:feed-assets",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "preweb": "npm run prepare:feed-assets",
    "web": "expo start --web",
    "pregallery": "npm run prepare:feed-assets",
    "gallery": "expo start --web --localhost --port 8083",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/model/*.test.mjs src/feed/*.test.mjs src/hooks/*.test.mjs src/theme/*.test.mjs src/native/*.test.mjs src/plugins/*.test.mjs src/chat/*.test.mjs src/panels/*.test.mjs plugins/*.test.js scripts/*.test.cjs",
    "prebuild:android": "npm run patch:markdown && npm run patch:dev-menu && expo prebuild --platform android",
    "build:android": "bash scripts/build-android.sh",
    "lint": "eslint . --max-warnings 0",
    "patch:markdown": "node scripts/patch-enriched-markdown.cjs",
    "patch:dev-menu": "node scripts/patch-dev-menu.cjs",
    "prepare:feed-assets": "node scripts/prepare-feed-assets.cjs",
    "postinstall": "npm run patch:markdown && npm run patch:dev-menu && npm run prepare:feed-assets",
    "doctor": "env npm_config_loglevel=notice expo-doctor",
    "audit:deps": "node scripts/audit-dependencies.cjs && npm audit signatures && npm run patch:markdown && npm run prepare:feed-assets && npm run check:audit-boundary",
    "check:audit-boundary": "node scripts/check-android-audit-boundary.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@json-render/core": "0.21.3",
    "@json-render/react-native": "0.21.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "expo": "58.0.26",
    "expo-asset": "58.0.21",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.21",
    "expo-file-system": "58.0.14",
    "expo-font": "58.0.12",
    "expo-haptics": "58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-linking": "58.0.17",
    "expo-localization": "~58.0.5",
    "expo-media-library": "58.0.14",
    "expo-router": "58.0.32",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "58.0.14",
    "katex": "^0.19.1",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0",
    "remend": "1.3.0",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "1.21.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >=26.0.0"
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableVideo": false,
    "enableCodeHighlight": true,
    "codeHighlightLanguages": [
      "typescript",
      "javascript",
      "json",
      "bash",
      "python"
    ]
  },
  "allowScripts": {
    "react-native-enriched-markdown@1.1.1": true,
    "unrs-resolver": false
  },
  "overrides": {
    "@expo/cli": {
      "glob": "^14.0.2"
    },
    "@expo/fingerprint": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
